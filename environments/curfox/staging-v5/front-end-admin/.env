# Application environment (e.g., development, staging, production)
VUE_APP_ENV=staging

# Base API URL for the Curfox backend services
VUE_APP_API_URL="https://dev8.api.curfox-huawei-staging.parallaxtec.com/api"

# DigitalOcean Spaces bucket URL for static assets
VUE_APP_BUCKET_URL="https://curfox.sgp1.cdn.digitaloceanspaces.com/"

# Indicates whether the app is running in tenant mode
VUE_APP_IS_TENANT=1

# Default company logo path used in the application
VUE_APP_DEFAULT_COMPANY_LOGO_PATH="staging/company_core/logo.jpg"

# staging environment
VUE_APP_STAGING_TAG="qa-5"
VUE_APP_STAGING_BASE_DOMAIN="curfox-huawei-staging.parallaxtec.com"
# production environment (international use ".int" otherwise use "" empty)
VUE_APP_PROD_INT=""
VUE_APP_PROD_BASE_DOMAIN="curfox.com"
